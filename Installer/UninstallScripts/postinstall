#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
[ "$(/usr/bin/id -u)" = 0 ] || exit 77
[ "${3:-/}" = / ] || exit 1
# The package carries its own native removal engine. Cleaner tools may already
# have removed every installed executable and its trust metadata.
exec "$(/usr/bin/dirname "$0")/GuardUninstall" --uninstall
